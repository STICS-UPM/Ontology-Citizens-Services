#################################################################

###  https://stics.linkeddata.es/def/citser#BasicAdministrativeUnit
:BasicAdministrativeUnit rdf:type owl:Class ;
                         rdfs:label "Basic Administrative Unit" .


###  https://stics.linkeddata.es/def/citser#BasicAdministrativeUnitLegalRelationship
:BasicAdministrativeUnitLegalRelationship rdf:type owl:Class ;
                                          rdfs:subClassOf :BasicAdministrativeUnitRelationship ;
                                          rdfs:label "Basic Administrative Unit Legal Relationship" .


###  https://stics.linkeddata.es/def/citser#BasicAdministrativeUnitRelationship
:BasicAdministrativeUnitRelationship rdf:type owl:Class ;
                                     rdfs:label "Basic Administrative Unit Relationship" .


###  https://stics.linkeddata.es/def/citser#BasicAdministrativeUnitSpatialRelationship
:BasicAdministrativeUnitSpatialRelationship rdf:type owl:Class ;
                                            rdfs:subClassOf :BasicAdministrativeUnitRelationship ;
                                            rdfs:label "Basic Administrative Unit Spatial Relationship" .


###  https://stics.linkeddata.es/def/citser#BasicAdministrativeUnitTemporalRelationship
:BasicAdministrativeUnitTemporalRelationship rdf:type owl:Class ;
                                             rdfs:subClassOf :BasicAdministrativeUnitRelationship ;
                                             rdfs:label "Basic Administrative Unit Temporal Relationship" .


###  https://stics.linkeddata.es/def/citser#GroupParty
:GroupParty rdf:type owl:Class ;
            rdfs:label "Group Party" .


###  https://stics.linkeddata.es/def/citser#Land
:Land rdf:type owl:Class ;
      rdfs:label "Land" .


###  https://stics.linkeddata.es/def/citser#LandAdministrationProcess
:LandAdministrationProcess rdf:type owl:Class ;
                           rdfs:subClassOf :Process ;
                           rdfs:label "Land Administration Process" .


###  https://stics.linkeddata.es/def/citser#Party
:Party rdf:type owl:Class ;
       rdfs:label "Party" .


###  https://stics.linkeddata.es/def/citser#PermanenetResidenceVerification
:PermanenetResidenceVerification rdf:type owl:Class ;
                                 rdfs:subClassOf :Process ;
                                 rdfs:label "Permanenet Residence Verification" .


###  https://stics.linkeddata.es/def/citser#PhysicalPerson
:PhysicalPerson rdf:type owl:Class ;
                rdfs:subClassOf :Party ;
                rdfs:label "Physical Person" .


###  https://stics.linkeddata.es/def/citser#Process
:Process rdf:type owl:Class ;
         rdfs:label "Process" .


###  https://stics.linkeddata.es/def/citser#Responsability
:Responsability rdf:type owl:Class ;
                rdfs:subClassOf :Rule ;
                rdfs:label "Responsability" .


###  https://stics.linkeddata.es/def/citser#Restriction
:Restriction rdf:type owl:Class ;
             rdfs:subClassOf :Rule ;
             rdfs:label "Restriction" .


###  https://stics.linkeddata.es/def/citser#Right
:Right rdf:type owl:Class ;
       rdfs:subClassOf :Rule ;
       rdfs:label "Right" .


###  https://stics.linkeddata.es/def/citser#Rule
:Rule rdf:type owl:Class ;
      rdfs:label "Rule" .


###  https://stics.linkeddata.es/def/citser#Source
:Source rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :acceptance ;
                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:dateTime
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :extArchiveID ;
                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange owl:Thing
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :lifeSpanStramp ;
                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:dateTime
                        ] ;
        rdfs:label "Source" .


###  https://stics.linkeddata.es/def/citser#SpatialUnit
:SpatialUnit rdf:type owl:Class ;
             rdfs:label "Spatial Unit" .


###  https://stics.linkeddata.es/def/citser#SpatialUnitGroup
:SpatialUnitGroup rdf:type owl:Class ;
                  rdfs:label "Spatial Unit Group" .


