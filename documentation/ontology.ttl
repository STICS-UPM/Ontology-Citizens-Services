#################################################################
#    Object Properties
#################################################################

###  https://stics.linkeddata.es/def/citser#administeredBy
:administeredBy rdf:type owl:ObjectProperty ;
                rdfs:domain :Land ;
                rdfs:range :LandAdministrationProcess ;
                rdfs:label "administered by" .


###  https://stics.linkeddata.es/def/citser#appliesFor
:appliesFor rdf:type owl:ObjectProperty ;
            rdfs:domain :PhysicalPerson ;
            rdfs:range :PermanenetResidenceVerification ;
            rdfs:label "applies for" .


###  https://stics.linkeddata.es/def/citser#basedOnSource
:basedOnSource rdf:type owl:ObjectProperty ;
               rdfs:domain :Rule ;
               rdfs:range :Source ;
               rdfs:label "based on source" .


###  https://stics.linkeddata.es/def/citser#composedBySpatialUnit
:composedBySpatialUnit rdf:type owl:ObjectProperty ;
                       rdfs:domain :SpatialUnitGroup ;
                       rdfs:range :SpatialUnit ;
                       rdfs:label "composed by spatial unit" .


###  https://stics.linkeddata.es/def/citser#composedBySpatialUnitGroup
:composedBySpatialUnitGroup rdf:type owl:ObjectProperty ;
                            rdfs:domain :SpatialUnitGroup ;
                            rdfs:range :SpatialUnitGroup ;
                            rdfs:label "composed by spatial unit group" .


###  https://stics.linkeddata.es/def/citser#composedBySubSpatialUnitGroup
:composedBySubSpatialUnitGroup rdf:type owl:ObjectProperty ;
                               rdfs:domain :SpatialUnit ;
                               rdfs:range :SpatialUnit ;
                               rdfs:label "composed by sub spatial unit group" .


###  https://stics.linkeddata.es/def/citser#consistOfSpatialUnit
:consistOfSpatialUnit rdf:type owl:ObjectProperty ;
                      rdfs:domain :BasicAdministrativeUnit ;
                      rdfs:range :SpatialUnit ;
                      rdfs:label "consist of spatial unit" .


###  https://stics.linkeddata.es/def/citser#coveredBy
:coveredBy rdf:type owl:ObjectProperty ;
           rdfs:domain :Land ;
           rdfs:range :Rule ;
           rdfs:label "covered by" .


###  https://stics.linkeddata.es/def/citser#involedBasicAdministrativeUnit
:involedBasicAdministrativeUnit rdf:type owl:ObjectProperty ;
                                rdfs:domain :BasicAdministrativeUnitRelationship ;
                                rdfs:range :BasicAdministrativeUnit ;
                                rdfs:label "involed basic administrative unit" .


###  https://stics.linkeddata.es/def/citser#registeredUnder
:registeredUnder rdf:type owl:ObjectProperty ;
                 rdfs:domain :BasicAdministrativeUnit ;
                 rdfs:range :Rule ;
                 rdfs:label "registered under" .


###  https://stics.linkeddata.es/def/citser#takesPartyAt
:takesPartyAt rdf:type owl:ObjectProperty ;
              rdfs:domain :Party ;
              rdfs:range :GroupParty ,
                         :Process ;
              rdfs:label "takes party at" .


