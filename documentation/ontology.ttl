#################################################################

###  https://stics.linkeddata.es/def/citser#acceptance
:acceptance rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:dateTime ;
            rdfs:label "acceptance" .


###  https://stics.linkeddata.es/def/citser#availabilityStatus
:availabilityStatus rdf:type owl:DatatypeProperty ;
                    rdfs:label "availability status" .


###  https://stics.linkeddata.es/def/citser#extArchiveID
:extArchiveID rdf:type owl:DatatypeProperty ;
